generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum AdminRole {
  OWNER
  ADMIN
  MODERATOR
}

enum RecordStatus {
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
  REFUNDED
}

model AdminUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(ADMIN)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model MemberApplication {
  id           String       @id @default(cuid())
  firstName    String
  lastName     String
  email        String
  phone        String
  memberType   String
  province     String
  city         String
  church       String?
  status       RecordStatus @default(PENDING)
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status])
  @@index([email])
}

model Church {
  id           String       @id @default(cuid())
  name         String
  denomination String
  province     String
  city         String
  address      String
  phone        String?
  services     String?
  status       RecordStatus @default(PENDING)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Pastor {
  id        String       @id @default(cuid())
  name      String
  title     String?
  church    String?
  province  String
  city      String
  phone     String?
  email     String?
  status    RecordStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Business {
  id          String       @id @default(cuid())
  name        String
  category    String
  city        String
  phone       String?
  description String
  featured    Boolean      @default(false)
  status      RecordStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Advert {
  id            String       @id @default(cuid())
  title         String
  business      String
  contact       String
  phone         String
  description   String
  duration      String
  amount        String
  paymentMethod String
  status        RecordStatus @default(PENDING)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model Payment {
  id            String        @id @default(cuid())
  payerName     String
  reference     String        @unique
  amount        String
  paymentMethod String
  status        PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Event {
  id          String       @id @default(cuid())
  title       String
  date        DateTime
  time        String
  location    String
  organiser   String
  category    String
  description String
  status      RecordStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model PrayerRequest {
  id        String       @id @default(cuid())
  name      String
  city      String
  request   String
  anonymous Boolean      @default(false)
  prayers   Int          @default(0)
  status    RecordStatus @default(PENDING)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Product {
  id          String       @id @default(cuid())
  name        String
  category    String
  price       String
  priceZig    String?
  description String
  status      RecordStatus @default(APPROVED)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Book {
  id          String       @id @default(cuid())
  title       String
  author      String
  category    String
  price       String
  priceZig    String?
  language    String
  description String
  status      RecordStatus @default(APPROVED)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}
